// Generated by the jessie_bio compiler from a canvas. Do not edit by hand:
// change the canvas and recompile. This job's inputs and outputs: job.json.

{% for include in includes %}
include { {{ include.process }} as {{ include.alias }} } from './{{ include.path }}'
{% endfor %}
{% if inputs %}

params {
    // Each job input is the path to its manifest (a CSV of files).
{% for input in inputs %}
    {{ input.name }}: Path
{% endfor %}
}
{% endif %}

workflow {
    main:
{% for input in inputs %}
    {{ input.name }} = {{ input.lines[0] }}
{% for line in input.lines[1:] %}
        {{ line }}
{% endfor %}

{% endfor %}
{% for call in calls %}
{% if call.args %}
    {{ call.alias }}(
{% for arg in call.args %}
        {{ arg.lines[0] }}
{% for line in arg.lines[1:] %}
            {{ line }}
{% endfor %}
{% endfor %}
    )
{% else %}
    {{ call.alias }}()
{% endif %}
{% endfor %}

    publish:
{% for output in outputs %}
    {{ output.name }} = {{ output.alias }}.out.{{ output.port }}
{% endfor %}
}

output {
{% for output in outputs %}
    {{ output.name }} {
{% if output.per_sample %}
        path { meta, _files -> "{{ output.name }}/${meta.id}" }
{% else %}
        path "{{ output.name }}"
{% endif %}
    }
{% endfor %}
}
