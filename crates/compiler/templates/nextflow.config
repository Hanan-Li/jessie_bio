// Generated by the jessie_bio compiler. Do not edit by hand.

docker.enabled = true

// Copy published outputs: the agent hashes and uploads them, and the work
// directory may be cleaned up afterwards.
workflow.output.mode = 'copy'

// Task-level record of the run, parsed by the agent.
trace {
    enabled = true
    file = 'trace.tsv'
    overwrite = true
    fields = 'task_id,hash,name,process,tag,status,exit,submit,start,complete,duration,realtime,workdir'
}
